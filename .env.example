# Plantilla de configuración. Copiar a .env y completar:
#   cp .env.example .env
# .env nunca se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://matlog:CAMBIAR@localhost:5434/matlog
# Solo para pytest: se borra y recrea en cada ejecución. Debe ser otra base.
TEST_DATABASE_URL=postgresql+psycopg://matlog:CAMBIAR@localhost:5434/matlog_test

# --- Autenticación ---
# Mínimo 32 caracteres. Generar con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR
# HS256, HS384 o HS512.
JWT_ALGORITHM=HS256
# Vida de cada token. El frontend lo renueva mientras se usa la app, así que en la práctica
# es el tiempo de inactividad tras el que hay que volver a entrar. 1440 min = 24 h.
JWT_EXPIRE_MINUTES=1440
# Duración máxima de una sesión desde el login, por mucho que se renueve el token.
SESION_MAX_DIAS=7

# --- Registro ---
# Código que se comparte con los compañeros para poder crear cuenta (mín. 8 caracteres).
CODIGO_INVITACION=CAMBIAR

# --- Límite de intentos fallidos (login y código de invitación) ---
# Al superarlos se responde 429 hasta que caduquen los fallos más antiguos de la ventana.
# Detrás de un proxy, arrancar uvicorn con --proxy-headers --forwarded-allow-ips=<ip del proxy>
# para que el límite por IP use la IP real del cliente.
LIMITE_FALLOS_USUARIO=5
LIMITE_FALLOS_IP=20
LIMITE_VENTANA_MINUTOS=15

# --- Documentación de la API ---
# /docs, /redoc y /openapi.json. true en desarrollo; false en producción, donde solo
# servirían para que un atacante conozca todos los endpoints.
DOCS_HABILITADAS=true

# --- CORS ---
# Orígenes del frontend (repo matlog) en formato JSON: esquema://host[:puerto], sin barra
# final. No se admite "*".
CORS_ORIGINS=["http://localhost:5180"]
